{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@elis/types": ["./packages/types/src"],
      "@elis/types/*": ["./packages/types/src/*"],
      "@elis/contracts": ["./packages/contracts/src"],
      "@elis/contracts/*": ["./packages/contracts/src/*"],
      "@elis/chains": ["./packages/chains/src"],
      "@elis/chains/*": ["./packages/chains/src/*"],
      "@elis/tokens": ["./packages/tokens/src"],
      "@elis/tokens/*": ["./packages/tokens/src/*"],
      "@elis/security": ["./packages/security/src"],
      "@elis/security/*": ["./packages/security/src/*"],
      "@elis/routing": ["./packages/routing/src"],
      "@elis/routing/*": ["./packages/routing/src/*"],
      "@elis/execution": ["./packages/execution/src"],
      "@elis/execution/*": ["./packages/execution/src/*"],
      "@elis/sdk": ["./packages/sdk/src"],
      "@elis/sdk/*": ["./packages/sdk/src/*"],
      "@elis/ui": ["./packages/ui/src"],
      "@elis/ui/*": ["./packages/ui/src/*"],
                                                                                                                }
  },
  "include": [
    "packages/*/src/**/*",
    "apps/*/src/**/*",
    "tests/**/*",
    "scripts/**/*"
  ]
}
